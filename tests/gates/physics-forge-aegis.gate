# tests/gates/physics-forge-aegis.gate
# Mirrors hosted: host-gates.yml matrix forge-aegis 'tests/run_forge_aegis_host_gates.sh' (physics #53)
gate: PHYSICS-FORGE-AEGIS
manifest_version: 2
owner: physics
requires:
  - host
inputs:
  - forge/
  - nvrm/
  - m16/
  - sha256_clean.c
  - tests/test_forge_aegis_host.c
  - tests/run_forge_aegis_host_gates.sh
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["forge-aegis"]
expects:
  exit: 0
  verdict: PASS
timeout: 10m
exactness: EXACT
cache_scope: machine
